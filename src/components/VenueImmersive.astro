      <div class="avinu-sign reveal d3"><img src="/img/avinu-white.png" alt="Avinu Events" width="84" height="38" loading="lazy" /> Production partner</div>
    </div>
    <figure class="prod-media reveal img-reveal">
      <img src="/venues/atjc/media/avinu-event-outdoor-1600.webp" srcset="/venues/atjc/media/avinu-event-outdoor-800.webp 800w, /venues/atjc/media/avinu-event-outdoor-1600.webp 1600w" sizes="(max-width: 900px) 100vw, 45vw" width="1600" height="1067" alt="An evening celebration produced by Avinu Events, with string lights and an illuminated dance floor" loading="lazy" decoding="async" />
      <img class="inset" src="/venues/atjc/media/avinu-dj-800.webp" width="640" height="427" alt="An Avinu Events DJ performing" loading="lazy" decoding="async" />
      <figcaption>An Avinu Events production in South Florida</figcaption>
    </figure>
  </div>
</section>

<section class="plan" id="plan" aria-labelledby="plan-title">
  <div class="plan-bg"><img src={src(v.plan.bg, 1600)} width={w16(v.plan.bg)} height={hgt(v.plan.bg, w16(v.plan.bg))} alt="" loading="lazy" decoding="async" /></div>
  <div class="wrap">
    <div>
      <span class="kicker reveal" style="color:var(--gold-2)">Begin planning</span>
      <h2 class="reveal d1" id="plan-title">Your celebration <em>{v.plan.at}</em></h2>
    </div>
    <div class="plan-card reveal d2">
      <p>Share your date and guest count. We’ll send music, ceremony and lighting options designed for {v.plan.forThis}.</p>
      <a class="btn btn-gold" href="https://www.avinuevents.com/get-a-quote/">Check your date <Fragment set:html={ARROW} /></a>
      <a class="btn btn-line" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(v.plan.address)}`} target="_blank" rel="noopener">Get directions</a>
      <dl>
        <dt>Address</dt><dd>{v.plan.address}</dd>
        <dt>Venue</dt><dd>{v.plan.venueLabel} · <a href={`tel:${v.plan.venuePhone.replace(/[^+\d]/g, '')}`}>{v.plan.venuePhoneLabel}</a></dd>
        <dt>Entertainment</dt><dd>Avinu Events · <a href="tel:+17545474415">754-547-4415</a></dd>
      </dl>
    </div>
  </div>
</section>
<MoreVenues current={v.slug} foot={false} />
</main>

<footer>
  <span>{v.footer}</span>
  <span>Page by <a href="https://www.avinuevents.com">Avinu Events</a> · Photography: {v.credit}</span>
</footer>

<div class="mobile-cta" id="mobile-cta">
  <div class="mcta-top"><span class="mcta-label">{v.name}{city && ` · ${city}`}</span><a class="mcta-call" href="tel:+17545474415" aria-label="Call Avinu Events"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6.6 3.5l2.6 4.2-1.8 1.6a12.5 12.5 0 0 0 7.3 7.3l1.6-1.8 4.2 2.6-.9 2.9c-.2.6-.8 1-1.4 1A16.6 16.6 0 0 1 2.7 6.3c0-.6.4-1.2 1-1.4z"/></svg></a></div>
  <div class="mcta-btns"><a class="btn btn-gold" href="#plan">Check your date</a><a class="btn btn-line" href="/venues/">View more venues</a></div>
</div>

<dialog class="lb" id="lb" aria-label="Photo viewer">
  <div class="lb-inner">
    <div class="lb-top"><span id="lb-count"></span><button class="icon-btn" id="lb-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>
    <figure class="lb-fig" id="lb-fig">
      <img id="lb-img" alt="" />
      <button class="icon-btn lb-prev" id="lb-prev" aria-label="Previous photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button class="icon-btn lb-next" id="lb-next" aria-label="Next photo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg></button>
    </figure>
    <div class="lb-cap" id="lb-cap"></div>
  </div>
</dialog>

<script is:inline define:vars={{ D: data, CREDIT: v.credit }}>
const PH = D.photos, CELEBRATIONS = D.celebrations, MOMENTS = D.moments, COURSES = D.cuisine, REVIEWS = D.reviews;
const $ = (s, el = document) => el.querySelector(s);
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
const src = (n, size = 1600) => `/venues/${D.slug}/media/${n}-${size}.webp`;
const srcset = (n) => `${src(n, 800)} 800w, ${src(n, 1600)} ${Math.min(1600, PH[n].w)}w`;
function img(n, { sizes = '100vw', lazy = true, cls = '' } = {}) {
  const p = PH[n]; const el = new Image();
  el.src = src(n, 800); el.srcset = srcset(n); el.sizes = sizes; el.alt = p.alt;
  el.width = Math.min(1600, p.w); el.height = Math.round(el.width * p.h / p.w); el.decoding = 'async';
  if (lazy) el.loading = 'lazy'; if (cls) el.className = cls; return el;
}

/* Reproductor de video (igual que ATJC): solo reproduce si está visible, botón de pausa, sin audio */
const VIDS = D.videos;
const vsrc = (f) => `/venues/${D.slug}/media/${f}`;
const ICON_PAUSE = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>';
const ICON_PLAY = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5l12 7-12 7z"/></svg>';
const autoplayOK = !reduced && !(navigator.connection && navigator.connection.saveData);
const vpObs = new IntersectionObserver(es => es.forEach(e => { e.target._vp.visible = e.isIntersecting; e.target._vp.sync(); }), { threshold: .3 });
function vplayer(key, { cls = '' } = {}) {
  const v = VIDS[key];
  const el = document.createElement('div'); el.className = 'vp ' + cls;
  const video = document.createElement('video');
  Object.assign(video, { muted: true, loop: true, playsInline: true, preload: 'none', poster: vsrc(v.poster) });
  video.setAttribute('muted', ''); video.setAttribute('playsinline', ''); video.setAttribute('aria-label', v.label);
  video.append(Object.assign(document.createElement('source'), { src: vsrc(v.mp4), type: 'video/mp4' }));
  const ctrls = document.createElement('div'); ctrls.className = 'vp-ctrls';
  const btn = document.createElement('button'); btn.className = 'vp-btn'; ctrls.append(btn);
  el.append(video, ctrls);
  const st = { visible: false, active: true, userPaused: !autoplayOK };
  const paint = () => { const playing = !video.paused; btn.innerHTML = playing ? ICON_PAUSE : ICON_PLAY; btn.setAttribute('aria-label', (playing ? 'Pause' : 'Play') + ' video: ' + v.label); };
  st.sync = () => { if (st.visible && st.active && !st.userPaused) video.play().catch(() => {}); else if (!video.paused) video.pause(); };
  video.addEventListener('play', paint); video.addEventListener('pause', paint);
  video.addEventListener('playing', () => el.classList.add('ready'), { once: true });
  btn.addEventListener('click', () => { st.userPaused = !video.paused; if (!st.userPaused) video.play().catch(() => {}); else video.pause(); });
  paint(); el._vp = st; vpObs.observe(el);
  return { el, video, setActive(a) { st.active = a; st.sync(); }, pause() { st.userPaused = true; video.pause(); }, play() { st.userPaused = false; st.sync(); } };
}

/* HERO en escritorio: video horizontal opcional sobre la foto (aparece al empezar a reproducirse) */
if (D.heroVideo && VIDS[D.heroVideo] && matchMedia('(min-width: 901px)').matches && autoplayOK) {
  const v = VIDS[D.heroVideo], video = document.createElement('video');
  Object.assign(video, { muted: true, loop: true, playsInline: true, autoplay: true, preload: 'auto' });
  video.setAttribute('muted', ''); video.setAttribute('playsinline', ''); video.setAttribute('aria-hidden', 'true');
  video.append(Object.assign(document.createElement('source'), { src: vsrc(v.mp4), type: 'video/mp4' }));
  video.addEventListener('playing', () => video.classList.add('ready'), { once: true });
  $('.hero-media').append(video);
  const hc = $('.hero-credit'); if (hc) hc.textContent = 'Video: ' + CREDIT;
  let heroUserPaused = false;
  new IntersectionObserver(([e]) => { e.isIntersecting && !heroUserPaused ? video.play().catch(() => {}) : video.pause(); }).observe($('.hero'));
  const hb = document.createElement('button'); hb.className = 'icon-btn hero-pause'; hb.innerHTML = ICON_PAUSE; hb.setAttribute('aria-label', 'Pause background video');
  hb.addEventListener('click', () => {
    heroUserPaused = !video.paused;
    if (!heroUserPaused) { video.play().catch(() => {}); hb.innerHTML = ICON_PAUSE; hb.setAttribute('aria-label', 'Pause background video'); }
    else { video.pause(); hb.innerHTML = ICON_PLAY; hb.setAttribute('aria-label', 'Play background video'); }
  });
  $('.hero').append(hb);
}

/* HERO en móvil: el reel vertical llena la pantalla; en escritorio queda la foto */
if (D.heroMobileVideo && VIDS[D.heroMobileVideo] && matchMedia('(max-width: 900px)').matches && autoplayOK) {
  const hv = vplayer(D.heroMobileVideo, { cls: 'hero-vp' });
  hv.video.preload = 'auto'; $('.hero-media').append(hv.el);
  const hc = $('.hero-credit'); if (hc) hc.textContent = 'Video: ' + CREDIT;
  const hb = document.createElement('button'); hb.className = 'icon-btn hero-pause'; hb.innerHTML = ICON_PAUSE; hb.setAttribute('aria-label', 'Pause background video');
  hb.addEventListener('click', () => {
    if (hv.video.paused) { hv.play(); hb.innerHTML = ICON_PAUSE; hb.setAttribute('aria-label', 'Pause background video'); }
    else { hv.pause(); hb.innerHTML = ICON_PLAY; hb.setAttribute('aria-label', 'Play background video'); }
  });
  $('.hero').append(hb);
}

/* NAV */
const nav = $('#nav'), mobileCta = $('#mobile-cta');
let pastHero = false, atPlan = false;
const syncCta = () => mobileCta.classList.toggle('show', pastHero && !atPlan && !nav.classList.contains('open'));
new IntersectionObserver(([e]) => { atPlan = e.isIntersecting; syncCta(); }, { threshold: .15 }).observe(document.getElementById('plan'));
new IntersectionObserver(([e]) => { nav.classList.toggle('solid', !e.isIntersecting); pastHero = !e.isIntersecting; syncCta(); },
  { rootMargin: `-${parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 76}px 0px 0px 0px`, threshold: 0 }).observe($('.hero'));
const menuBtn = $('#menu-btn');
function setMenu(open) {
  nav.classList.toggle('open', open); menuBtn.setAttribute('aria-expanded', open);
  menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  document.body.style.overflow = open ? 'hidden' : ''; syncCta();
}
menuBtn.addEventListener('click', () => setMenu(!nav.classList.contains('open')));
document.querySelectorAll('.nav-links a').forEach(a => a.addEventListener('click', () => setMenu(false)));
addEventListener('keydown', e => { if (e.key === 'Escape' && nav.classList.contains('open')) { setMenu(false); menuBtn.focus(); } });
const links = [...document.querySelectorAll('.nav-links a')];
const secObs = new IntersectionObserver(entries => entries.forEach(e => {
  if (e.isIntersecting) links.forEach(a => a.setAttribute('aria-current', a.getAttribute('href') === '#' + e.target.id ? 'true' : 'false'));
}), { rootMargin: '-45% 0px -50% 0px' });
document.querySelectorAll('main > section').forEach(sec => secObs.observe(sec));

/* Revelado */
if (!reduced && 'IntersectionObserver' in window) {
  const ro = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('.reveal, .img-reveal').forEach(el => ro.observe(el));
} else document.querySelectorAll('.reveal, .img-reveal').forEach(el => el.classList.add('in'));

/* CELEBRATIONS: el recuadro toma la proporción real de la foto */
const tabsEl = $('#tabs'), stageMedia = $('#stage-media'), stageCopy = $('#stage-copy'), stageCap = $('#stage-cap');
const stagePanels = {}, stagePlayers = {};
const arOf = (n) => Math.max(.66, Math.min(1.5, PH[n].w / PH[n].h));
const hasVid = (c) => c.video && VIDS[c.video];
CELEBRATIONS.forEach((c, i) => {
  const b = document.createElement('button');
  Object.assign(b, { className: 'tab', id: 'tab-' + c.id }); b.setAttribute('role', 'tab');
  b.setAttribute('aria-label', c.label);
  b.innerHTML = `<span class="t-full">${c.label}</span><span class="t-short" aria-hidden="true">${c.short || c.label}</span>`;
  b.setAttribute('aria-controls', 'stage-panel'); b.setAttribute('aria-selected', i === 0); b.tabIndex = i === 0 ? 0 : -1;
  b.addEventListener('click', () => selectCelebration(i, true)); tabsEl.append(b);
  const panel = document.createElement('div');
  if (hasVid(c)) {
    panel.className = 'comp comp-reel';
    const pl = vplayer(c.video); pl.setActive(false); stagePlayers[c.id] = pl; panel.append(pl.el);
  } else {
    panel.className = 'comp comp-photo';
    const im = img(c.photo, { sizes: '(max-width: 900px) 100vw, 56vw', lazy: i !== 0 }); if (c.pos) im.style.objectPosition = c.pos;
    panel.append(im);
  }
  stageMedia.append(panel); stagePanels[c.id] = panel;
});
tabsEl.addEventListener('keydown', e => {
  const tabs = [...tabsEl.children], cur = tabs.findIndex(t => t.getAttribute('aria-selected') === 'true');
  let n = null;
  if (e.key === 'ArrowRight') n = (cur + 1) % tabs.length; if (e.key === 'ArrowLeft') n = (cur - 1 + tabs.length) % tabs.length;
  if (e.key === 'Home') n = 0; if (e.key === 'End') n = tabs.length - 1;
  if (n !== null) { e.preventDefault(); selectCelebration(n, true); tabs[n].focus(); }
});
function selectCelebration(i, animate) {
  const c = CELEBRATIONS[i];
  [...tabsEl.children].forEach((t, j) => { t.setAttribute('aria-selected', j === i); t.tabIndex = j === i ? 0 : -1; });
  $('#stage-panel').setAttribute('aria-labelledby', 'tab-' + c.id);
  Object.entries(stagePanels).forEach(([id, el]) => el.classList.toggle('on', id === c.id));
  Object.entries(stagePlayers).forEach(([id, pl]) => pl.setActive(id === c.id));
  stageMedia.style.setProperty('--ar', hasVid(c) ? 9 / 16 : arOf(c.photo));
  const cap = hasVid(c) ? `${c.caption || VIDS[c.video].label} · Video: ${CREDIT}` : `${c.caption || PH[c.photo].cap} · Photo: ${CREDIT}`;
  if (animate && !reduced) { stageCap.classList.add('out'); setTimeout(() => { stageCap.textContent = cap; stageCap.classList.remove('out'); }, 300); }
  else stageCap.textContent = cap;
  const render = () => {
    stageCopy.innerHTML = `<h3>${c.title}</h3><p>${c.text}</p><ul>${c.points.map(p => `<li>${p}</li>`).join('')}</ul><a class="btn btn-gold" href="#plan">${c.cta}</a>`;
    stageCopy.classList.remove('out');
  };
  if (animate && !reduced) { stageCopy.classList.add('out'); setTimeout(render, 260); } else render();
}
selectCelebration(0, false);

/* FILM: el mismo lugar, de la ceremonia a la noche */
const filmFrame = $('#film-frame'), filmSteps = $('#film-steps');
const filmPlayers = [];
const filmImgs = MOMENTS.map((m, i) => {
  if (m.video && VIDS[m.video]) { const pl = vplayer(m.video); pl.setActive(false); filmPlayers[i] = pl; filmFrame.prepend(pl.el); return pl.el; }
  const im = img(m.photo, { sizes: '(max-width: 900px) 100vw, 80vw' }); filmFrame.prepend(im);
  if (m.wide) { im.classList.add('wide'); im.style.objectPosition = m.pos || '50% 50%'; }
  return im;
});
MOMENTS.forEach((m, i) => {
  const b = document.createElement('button'); b.className = 'film-step'; b.setAttribute('aria-pressed', i === 0);
  b.innerHTML = `<b>${m.title}</b><span>${m.text}</span>`;
  b.addEventListener('click', () => setMoment(i)); filmSteps.append(b);
  b.addEventListener('pointerdown', () => filmSteps.classList.add('mouse'));
  b.addEventListener('keydown', () => filmSteps.classList.remove('mouse'));
});
function setMoment(i) {
  filmImgs.forEach((im, j) => im.classList.toggle('on', j === i));
  filmPlayers.forEach((pl, j) => pl && pl.setActive(j === i));
  [...filmSteps.children].forEach((b, j) => b.setAttribute('aria-pressed', j === i));
}
setMoment(0);

/* GALERÍA + LIGHTBOX */
const grid = $('#grid'), chips = $('#chips');
D.gallery.items.forEach(n => {
  const p = PH[n]; const b = document.createElement('button');
  b.className = 'tile reveal'; b.dataset.cat = p.cat; b.dataset.n = n;
  b.setAttribute('aria-label', `Open photo: ${p.cap}`);
  b.append(img(n, { sizes: '(max-width: 900px) 50vw, 33vw' }));
  const cap = document.createElement('span'); cap.className = 'cap'; cap.textContent = p.cap; b.append(cap);
  b.addEventListener('click', () => openLb(n, b)); grid.append(b);
});
if (!reduced) { const go = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); go.unobserve(e.target); } }), { rootMargin: '0px 0px -5% 0px' }); grid.querySelectorAll('.tile').forEach(t => go.observe(t)); }
else grid.querySelectorAll('.tile').forEach(t => t.classList.add('in'));
D.gallery.cats.forEach(([id, label], i) => {
  const b = document.createElement('button'); b.className = 'chip'; b.textContent = label; b.setAttribute('aria-pressed', i === 0);
  b.addEventListener('click', () => {
    [...chips.children].forEach(c => c.setAttribute('aria-pressed', c === b));
    grid.querySelectorAll('.tile').forEach(t => t.classList.toggle('hide', id !== 'all' && t.dataset.cat !== id));
    if (chips.scrollWidth > chips.clientWidth) b.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
  });
  chips.append(b);
});
/* Filtros de galeria en movil: flechas en los bordes (tapan el filtro que no cabe; nunca se ve cortado) */
(() => {
  const ch = document.getElementById('chips');
  if (!ch) return;
  const wrap = document.createElement('div'); wrap.className = 'chips-wrap';
  ch.parentNode.insertBefore(wrap, ch); wrap.append(ch);
  const mk = (cls, d, label, dir) => {
    const b = document.createElement('button'); b.type = 'button'; b.className = 'chips-arrow ' + cls; b.setAttribute('aria-label', label);
    b.innerHTML = '<span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="' + d + '"/></svg></span>';
    b.addEventListener('click', () => ch.scrollBy({ left: dir * ch.clientWidth * 0.6, behavior: 'smooth' }));
    wrap.append(b); return b;
  };
  const l = mk('l', 'M15 6l-6 6 6 6', 'More filters to the left', -1), r = mk('r', 'M9 6l6 6-6 6', 'More filters', 1);
  const sync = () => {
    const max = ch.scrollWidth - ch.clientWidth;
    const showL = max > 2 && ch.scrollLeft > 2, showR = max > 2 && ch.scrollLeft < max - 2;
    l.classList.toggle('show', showL); r.classList.toggle('show', showR);
    // un filtro que no cabe completo se oculta entero (nunca se ve una palabra cortada)
    const box = ch.getBoundingClientRect(), limL = box.left + (showL ? 44 : 0), limR = box.right - (showR ? 44 : 0);
    [...ch.children].forEach((c) => {
      const b = c.getBoundingClientRect(), parcial = b.left < limL - 1 || b.right > limR + 1;
      c.classList.toggle('chip-oculto', parcial);
    });
  };
  ch.addEventListener('scroll', sync, { passive: true }); addEventListener('resize', sync); sync();
})();
const lb = $('#lb'), lbImg = $('#lb-img'), lbCap = $('#lb-cap'), lbCount = $('#lb-count');
let lbList = [], lbIdx = 0, lbOpener = null;
function showLb(i, dir = 0) {
  lbIdx = (i + lbList.length) % lbList.length; const n = lbList[lbIdx], p = PH[n];
  const apply = () => { lbImg.src = src(n, 1600); lbImg.alt = p.alt; lbCap.innerHTML = `${p.cap}<small>Photo: ${CREDIT}</small>`; lbCount.textContent = `${lbIdx + 1} / ${lbList.length}`; lbImg.classList.remove('fade'); };
  if (dir && !reduced) { lbImg.classList.add('fade'); setTimeout(apply, 180); } else apply();
  new Image().src = src(lbList[(lbIdx + 1) % lbList.length], 1600);
}
function openLb(n, opener) { lbList = [...grid.querySelectorAll('.tile:not(.hide)')].map(t => t.dataset.n); lbOpener = opener; lb.showModal(); showLb(lbList.indexOf(n)); $('#lb-close').focus(); }
lb.addEventListener('close', () => lbOpener && lbOpener.focus());
$('#lb-close').addEventListener('click', () => lb.close());
$('#lb-prev').addEventListener('click', () => showLb(lbIdx - 1, -1));
$('#lb-next').addEventListener('click', () => showLb(lbIdx + 1, 1));
lb.addEventListener('keydown', e => { if (e.key === 'ArrowRight') { e.preventDefault(); showLb(lbIdx + 1, 1); } if (e.key === 'ArrowLeft') { e.preventDefault(); showLb(lbIdx - 1, -1); } });
lb.addEventListener('click', e => { if (e.target === lb || e.target.classList.contains('lb-inner')) lb.close(); });
let sx = null;
$('#lb-fig').addEventListener('pointerdown', e => { sx = e.clientX; });
$('#lb-fig').addEventListener('pointerup', e => { if (sx === null) return; const dx = e.clientX - sx; sx = null; if (Math.abs(dx) > 50) showLb(lbIdx + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1); });

/* COCINA (opcional) */
const courses = $('#courses');
if (courses) {
  COURSES.forEach(n => {
    const f = document.createElement('figure'); f.className = 'course';
    const w = document.createElement('div'); w.className = 'ph-wrap';
    const c = document.createElement('figcaption');
    if (n && typeof n === 'object' && n.video && VIDS[n.video]) {
      // video opcional dentro del carrusel de cocina: { "video": "clave", "cap": "..." }
      f.classList.add('course-v'); w.append(vplayer(n.video).el);
      c.innerHTML = `${n.cap || VIDS[n.video].label}<small>Video: ${CREDIT}</small>`;
    } else {
      const p = PH[n]; w.append(img(n, { sizes: '(max-width: 900px) 78vw, 30vw' }));
      c.innerHTML = `${p.cap}<small>${CREDIT}</small>`;
    }
    f.append(w, c); courses.append(f);
  });
  const step = () => courses.querySelector('.course').getBoundingClientRect().width + 19;
  $('#courses-prev').addEventListener('click', () => courses.scrollBy({ left: -step(), behavior: reduced ? 'auto' : 'smooth' }));
  $('#courses-next').addEventListener('click', () => courses.scrollBy({ left: step(), behavior: reduced ? 'auto' : 'smooth' }));
}

/* RESEÑAS */
const quote = $('#quote'), quoteWho = $('#quote-who'), dots = $('#q-dots');
let qi = 0;
REVIEWS.forEach((r, i) => { const d = document.createElement('button'); d.setAttribute('aria-label', `Review ${i + 1}: ${r.who}`); d.addEventListener('click', () => showQ(i)); dots.append(d); });
function showQ(i) {
  qi = (i + REVIEWS.length) % REVIEWS.length; const r = REVIEWS[qi];
  const apply = () => { quote.textContent = `“${r.q}”`; quoteWho.textContent = r.who; quote.classList.remove('fade'); };
  if (!reduced && quote.textContent) { quote.classList.add('fade'); setTimeout(apply, 300); } else apply();
  [...dots.children].forEach((d, j) => d.setAttribute('aria-current', j === qi));
}
$('#q-prev').addEventListener('click', () => showQ(qi - 1));
$('#q-next').addEventListener('click', () => showQ(qi + 1));
if (REVIEWS.length < 2) $('.voices-ctrl').hidden = true;
showQ(0);

/* Filas deslizables en movil: flecha discreta sobre la foto (derecha = siguiente; izquierda al avanzar) */
function railArrows(rail, mediaSel) {
  if (!rail || !rail.children.length) return;
  const host = rail.parentElement;
  if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
  const svg = (d) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="' + d + '"/></svg>';
  const mk = (dir) => {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'car-arrow ' + (dir < 0 ? 'car-prev' : 'car-next');
    b.setAttribute('aria-label', dir < 0 ? 'Previous' : 'Next');
    b.innerHTML = svg(dir < 0 ? 'M15 6l-6 6 6 6' : 'M9 6l6 6-6 6');
    b.addEventListener('click', () => {
      const it = rail.firstElementChild, gap = parseFloat(getComputedStyle(rail).columnGap) || 0;
      rail.scrollBy({ left: dir * ((it ? it.getBoundingClientRect().width : rail.clientWidth) + gap), behavior: reduced ? 'auto' : 'smooth' });
    });
    host.append(b); return b;
  };
  const prev = mk(-1), next = mk(1);
  const place = () => {
    const m = rail.querySelector(mediaSel); if (!m) return;
    const r = m.getBoundingClientRect();
    prev.style.top = next.style.top = (r.top - host.getBoundingClientRect().top + r.height / 2) + 'px';
  };
  const sync = () => {
    const max = rail.scrollWidth - rail.clientWidth;
    prev.classList.toggle('show', rail.scrollLeft > 4);
    next.classList.toggle('show', max > 4 && rail.scrollLeft < max - 4);
  };
  rail.addEventListener('scroll', sync, { passive: true });
  addEventListener('resize', () => { place(); sync(); });
  place(); sync(); setTimeout(() => { place(); sync(); }, 800);
}
railArrows(document.querySelector('.space-grid'), '.ph-wrap');
railArrows(document.getElementById('courses'), '.ph-wrap');
</script>
</body>
</html>

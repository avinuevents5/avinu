<section class="production" id="production">
  <div class="wrap prod-grid">
    <div>
      <span class="kicker reveal" style="color:#8c6c24">Music, lighting &amp; production</span>
      <h2 class="reveal d1">The room sets the stage. <em>We fill it.</em></h2>
      <p class="reveal d2">{v.production.text}</p>
      <div class="pillars reveal d2">
        <div class="pillar"><b>Music</b><span>DJs and MCs, ceremony singers and cantors, live musicians and bands.</span></div>
        <div class="pillar"><b>Lighting</b><span>{v.production.lighting}</span></div>
        <div class="pillar"><b>Production</b><span>Sound, LED walls and projection for entrances, speeches and montages.</span></div>

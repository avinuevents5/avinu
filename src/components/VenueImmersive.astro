      <button class="icon-btn" id="courses-prev" aria-label="Previous dishes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button class="icon-btn" id="courses-next" aria-label="Next dishes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>
  <div class="courses" id="courses" tabindex="0" aria-label={`Dishes at ${v.name}`}></div>
</section>
)}

<section class="voices" aria-labelledby="voices-title">
  <div class="wrap">
    <span class="kicker reveal" style="color:#8c6c24" id="voices-title">{v.reviews.kicker}</span>
    {v.reviews.rating && <p class="rating reveal"><span aria-hidden="true">★</span> {v.reviews.rating} <small>· {v.reviews.count}</small></p>}
    <blockquote id="quote" aria-live="polite"></blockquote>

---
import Noir from '../layouts/Noir.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const singers = await getCollection('singers');
  return singers.map((e) => ({ params: { singer: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, role, photo, languages = [], specialties = [], gallery = [], videos = [], audio = [], summary, connectNote } = entry.data;
const firstName = title.split(' ')[0];

const others = (await getCollection('singers'))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((e) => ({ name: e.data.title, photo: e.data.photo ?? '', href: `/${e.id}/` }));
---

<Noir title={title} titleSuffix={entry.data.titleSuffix ?? true} description={summary ?? role}>
  <!-- BIO + PHOTO (title sits beside the photo) -->
  <section class="band bio-band">
    <div class="bio-grid">
      <div class="bio" data-reveal>
        <p class="eyebrow">Vocalist</p>
        <h1>{title}</h1>
        {role && <p class="role">{role}</p>}
        <div class="prose"><Content /></div>
        <div class="facts-row">
          {languages.length > 0 && (
            <div class="fact"><h3>Fluent Languages</h3><p>{languages.join(', ')}</p></div>
          )}
          {specialties.length > 0 && (
            <div class="fact"><h3>Specializes In</h3><p>{specialties.join(', ')}</p></div>
          )}
        </div>
        <a class="btn-primary bio-cta" href="/get-a-quote/">Book {firstName}</a>
      </div>
      <div class="bio-photo" data-reveal>
        <img class="bp-img" src={photo} alt={title} />
      </div>
    </div>
  </section>

  <!-- VIDEOS -->
  {videos.length > 0 && (
    <section class="band midnight">
      <header class="band-head" data-reveal><p class="eyebrow">Watch</p><h2>Videos</h2></header>
      <div class="videos" data-reveal-group>
        {videos.map((v) => (
          <div class="video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v}`}
              title={`${title} — video`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- LISTEN / SONGS -->
  {audio.length > 0 && (
    <section class="band">
      <header class="band-head" data-reveal><p class="eyebrow">Listen</p><h2>Songs</h2></header>
      <div class="tracks" data-reveal>
        {audio.map((src) => (
          <iframe class="sc-player" width="100%" height="420" scrolling="no" frameborder="no" loading="lazy" src={src}></iframe>
        ))}
      </div>
    </section>
  )}

  <!-- GALLERY (only if present) -->
  {gallery.length > 0 && (
    <section class="band midnight">
      <header class="band-head" data-reveal><p class="eyebrow">Gallery</p><h2>On the stage</h2></header>
      {gallery.length > 4 ? (
        // Más de 4 fotos: carrusel. Se ven las 4 primeras (2 en el celular) y las flechas pasan página.
        <div class="g-carousel" data-carousel>
          <button type="button" class="g-arrow g-prev" aria-label="Previous photos" data-prev hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <div class="g-track" data-track data-reveal-group>
            {gallery.map((src) => (
              <div class="g-cell"><div class="g-img" style={`background-image:url('${src}')`}></div></div>
            ))}
          </div>
          <button type="button" class="g-arrow g-next" aria-label="More photos" data-next>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      ) : (
        <div class="gallery" data-reveal-group>
          {gallery.map((src) => (
            <div class="g-cell"><div class="g-img" style={`background-image:url('${src}')`}></div></div>
          ))}
        </div>
      )}
    </section>
  )}

  <!-- CONNECT WITH {NAME} -->
  <section class="band connect">
    <div class="connect-inner">
      <h2 data-reveal>Connect with {title}</h2>
      {connectNote && <p class="connect-note" data-reveal>{connectNote}</p>}
      <div class="connect-cols" data-reveal-group>
        <div class="ccol">
          <h3>Call Now</h3>
          <p>Instantly connect with {title} and discuss your requirements.</p>
          <a class="link-arrow" href="tel:+17545474415">Call Now</a>
        </div>
        <div class="ccol">
          <h3>Book Now</h3>
          <p>Save a date and let {firstName} mesmerize your audience.</p>
          <a class="link-arrow" href="/get-a-quote/">Book Now</a>
        </div>
        <div class="ccol">
          <h3>Contact Us</h3>
          <p>For general inquiries, collaborations, or feedback, reach out to us.</p>
          <a class="link-arrow" href="/get-a-quote/">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- OTHER SINGERS -->
  <section class="band midnight">
    <header class="band-head" data-reveal><p class="eyebrow">More voices</p><h2>Other Singers</h2></header>
    <div class="others" data-reveal-group>
      {others.map((o) => (
        <a class="person" href={o.href}>
          <div class="person-img" style={`background-image:url('${o.photo}')`}></div>
          <span class="person-name">{o.name}</span>
        </a>
      ))}
    </div>
  </section>

  <style>
    /* TITLE (inside the bio column) */
    .bio h1 { font-size: clamp(2.8rem, 5vw, 4rem); line-height: 1.05; margin: 0.6rem 0 0; }
    .role { color: var(--fg); font-family: var(--font-display); font-style: italic; font-size: clamp(1.05rem, 2.4vw, 1.35rem); margin: 0.5rem 0 1.75rem; }

    /* SHELL */
    .band { padding: 4.5rem 1.5rem; }
    .band > * { max-width: var(--maxw); margin-left: auto; margin-right: auto; }
    .band.midnight { background: var(--midnight); }
    .band-head { text-align: center; margin-bottom: 3rem; }
    .band-head h2 { font-size: clamp(2rem, 4.5vw, 3rem); margin-top: 0.5rem; }

    /* BIO + PHOTO */
    .bio-band { padding-top: 5.5rem; }
    .bio-grid { display: grid; grid-template-columns: 1fr 400px; gap: 4rem; align-items: center; }
    .prose :global(p) { color: var(--muted-text); font-size: 1.05rem; line-height: 1.78; margin: 0 0 1.25rem; }
    .facts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: 2rem 0; }
    .fact h3 { font-family: var(--font-body); font-weight: 600; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.7rem; color: var(--accent-ink); margin-bottom: 0.5rem; }
    .fact p { color: var(--fg); font-size: 0.95rem; margin: 0; }
    .bp-img { display: block; width: 100%; height: auto; border-radius: 18px; border: 1px solid var(--line); }

    /* VIDEOS */
    .videos { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 1.5rem; max-width: 920px; margin: 0 auto; }
    .video { aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: #000; }
    .video iframe { width: 100%; height: 100%; border: 0; display: block; }

    /* SONGS */
    .tracks { max-width: 820px; margin: 0 auto; display: grid; gap: 1.25rem; }
    .sc-player { border: 1px solid var(--line); border-radius: 14px; display: block; }

    /* GALLERY — fills exactly one row however many images there are */
    .gallery { display: flex; gap: 1rem; }
    .g-cell { border-radius: 14px; overflow: hidden; flex: 1; min-width: 0; }
    .g-img { aspect-ratio: 3 / 4; background-size: cover; background-position: center; transition: transform 0.6s cubic-bezier(0.16,1,0.3,1); }
    .g-cell:hover .g-img { transform: scale(1.06); }

    /* Carrusel (más de 4 fotos): 4 por vista, 2 en el celular; se desliza con el dedo o con las flechas */
    .g-carousel { position: relative; }
    .g-track { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
    .g-track::-webkit-scrollbar { display: none; }
    .g-track .g-cell { flex: 0 0 calc((100% - 3rem) / 4); scroll-snap-align: start; }
    .g-arrow { position: absolute; top: 50%; z-index: 2; transform: translateY(-50%); display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.28); background: rgba(10, 10, 10, 0.6); color: #fff; cursor: pointer; backdrop-filter: blur(6px); transition: background 0.2s ease, border-color 0.2s ease; }
    .g-arrow:hover { background: rgba(10, 10, 10, 0.85); border-color: rgba(255, 255, 255, 0.6); }
    .g-arrow:focus-visible { outline: 2px solid #d9b866; outline-offset: 2px; }
    .g-arrow[hidden] { display: none; }
    .g-arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .g-prev { left: -23px; }
    .g-next { right: -23px; }

    /* CONNECT */
    .connect-inner { max-width: var(--maxw); }
    .connect h2 { font-family: var(--font-display); font-style: italic; font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 2.5rem; }
    .connect-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .ccol h3 { font-family: var(--font-display); font-weight: 500; font-size: 1.45rem; margin-bottom: 0.6rem; }
    .ccol p { color: var(--muted-text); font-size: 0.95rem; line-height: 1.6; margin: 0 0 1.2rem; min-height: 3.2em; }
    .connect-note { color: var(--muted-text); font-size: 1.05rem; line-height: 1.7; max-width: 52rem; margin: 0 0 2.8rem; }

    /* OTHER SINGERS */
    .others { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .person { position: relative; display: block; border-radius: 16px; overflow: hidden; }
    .person-img { aspect-ratio: 3 / 4; background-size: cover; background-position: center top; transition: transform 0.6s cubic-bezier(0.16,1,0.3,1); }
    .person:hover .person-img { transform: scale(1.06); }
    .person::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8), transparent 55%); }
    .person-name { position: absolute; left: 1rem; bottom: 0.9rem; z-index: 2; font-family: var(--font-display); font-size: 1.2rem; }

    @media (max-width: 900px) {
      .bio-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .bio-photo { order: -1; max-width: 420px; width: 100%; margin: 0 auto; }
      .gallery { grid-template-columns: repeat(2, 1fr); }
      .g-track .g-cell { flex-basis: calc((100% - 1rem) / 2); }
      .g-prev { left: 6px; }
      .g-next { right: 6px; }
      .connect-cols { grid-template-columns: 1fr; gap: 1.5rem; }
      .ccol p { min-height: 0; }
      .others { grid-template-columns: 1fr; }
    }
    @media (max-width: 520px) { .videos { grid-template-columns: 1fr; } .facts-row { grid-template-columns: 1fr; } }

    @media (prefers-reduced-motion: no-preference) {
      :global(html.js) [data-reveal],
      :global(html.js) [data-reveal-group] > * { opacity: 0; }
    }
  </style>

  <script>
    import { animate, inView, stagger } from 'motion';

    // Carrusel de la galería: las flechas pasan una página (lo que se ve) y se ocultan en los extremos.
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
      const track = c.querySelector<HTMLElement>('[data-track]');
      const prev = c.querySelector<HTMLButtonElement>('[data-prev]');
      const next = c.querySelector<HTMLButtonElement>('[data-next]');
      if (!track || !prev || !next) return;
      const step = () => track.clientWidth + 16; // ancho visible + el espacio entre fotos
      const update = () => {
        prev.hidden = track.scrollLeft < 4;
        next.hidden = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
      next.addEventListener('click', () => track.scrollBy({ left: step() }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });

    if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      inView('[data-reveal]', (el) => {
        animate(el, { opacity: [0, 1], y: [28, 0] }, { duration: 0.8, ease: [0.16, 1, 0.3, 1] });
      }, { margin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal-group]').forEach((group) => {
        inView(group, () => {
          animate(Array.from(group.children), { opacity: [0, 1], y: [28, 0] },
            { delay: stagger(0.08), duration: 0.7, ease: [0.16, 1, 0.3, 1] });
        }, { margin: '0px 0px -10% 0px' });
      });
    }
  </script>
</Noir>

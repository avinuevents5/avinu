---
import Noir from '../../layouts/Noir.astro';
import { phone } from '../../data/home';

const tel = phone.replace(/[^+\d]/g, '');

// Mismo Calendly y mismo diseño que "Schedule a call" en /get-a-quote (CRM, InquiryForm .eb-cal-card):
// póster a la izquierda, Calendly sin su panel de detalles y con los colores de la marca.
const calendly = 'https://calendly.com/avinuevents/event-consultation'
  + '?embed_type=Inline&embed_domain=www.avinuevents.com&hide_gdpr_banner=1'
  + '&hide_event_type_details=1&background_color=fffdfa&text_color=17140f&primary_color=8a6a2e';
---

<Noir
  title="Schedule a consultation"
  description="Schedule a 15-minute call with Mark Levine of Avinu Music & Productions to plan your event: DJ & MC, live music, production & lighting, LED displays. Call +1 754-547-4415."
>
  <section class="consult">
    <header class="page-head">
      <p class="eyebrow head-kicker">Consultation</p>
      <h1 class="head-h1">Let's Plan Your <span class="ital">Event</span></h1>
      <p class="head-sub">Pick a time for a 15-minute call. <span class="head-call">Prefer to talk now? <a href={`tel:${tel}`}>Call {phone}</a></span></p>
    </header>

    <div class="cal-card">
      <img
        class="cal-poster"
        src="/consultation/lets-talk-poster.jpg"
        width="941"
        height="1672"
        alt="Mark Levine — Let’s talk about your event! 15-minute call; web conferencing details provided upon confirmation. Tell us a little about your celebration, explore entertainment and production options, and get personalized guidance for your event. DJ & MC, live music, production & lighting, LED displays."
      />
      <iframe id="consult-cal" class="cal-frame" src={calendly} title="Schedule a call with Avinu" loading="eager"></iframe>
    </div>
  </section>

  <style>
    .ital { font-style: italic; font-weight: 400; letter-spacing: -0.01em; }

    /* Título compacto: la tarjeta entera (640 px) tiene que verse sin bajar en una MacBook (~830 px visibles). */
    .consult { padding: clamp(1rem, 2.5vh, 1.75rem) var(--gutter) clamp(4rem, 8vh, 6rem); }
    .page-head { max-width: 797px; margin: 0 auto; }
    .head-kicker { display: block; margin-bottom: 0.5rem; }
    .head-h1 { font-size: clamp(2rem, 3vw, 2.6rem); letter-spacing: -0.02em; line-height: 1.05; }
    .head-sub { color: var(--muted-text); font-size: 1rem; margin: 0.45rem 0 0; }
    .head-call { margin-left: 0.6rem; font-size: 0.95rem; white-space: nowrap; }
    .head-call a { color: var(--fg); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

    /* Tarjeta: póster + Calendly, igual que en /get-a-quote */
    .cal-card {
      margin: clamp(0.9rem, 2vh, 1.25rem) auto 0; display: grid; overflow: hidden; border-radius: 18px;
      background: #fffdfa; box-shadow: 0 0 0 1px rgba(23,20,15,.1), 0 1px 2px rgba(23,20,15,.06), 0 18px 48px rgba(23,20,15,.12);
    }
    .cal-poster { display: block; max-width: none; object-fit: cover; background: #0b0d1a; }
    .cal-frame { display: block; border: 0; background: #fffdfa; }

    /* Escritorio: Calendly se dibuja a 410 × 600 y se amplía ×1.0667 (el calendario llena su columna; con
       menos de 600 px de alto por dentro Calendly saca una barra). Tarjeta ≈ 360 + 437 = 797 × 640. */
    @media (min-width: 900px) {
      /* Título y teléfono en una fila (sin el "Consultation" de arriba): 92 + ~70 + 640 cabe en ~830 px. */
      .page-head { width: 797px; display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
      .head-kicker { display: none; }
      .consult { padding-top: 0.6rem; }
      .head-sub { margin: 0; text-align: right; }
      .head-sub .head-call { display: block; margin: 0.15rem 0 0; }
      .cal-card { --cal-s: 1.0667; --cal-h: calc(600px * var(--cal-s)); width: fit-content; height: var(--cal-h);
        grid-template-columns: auto calc(410px * var(--cal-s)); grid-template-rows: var(--cal-h); }
      .cal-poster { height: var(--cal-h); width: auto; aspect-ratio: 941 / 1672; }
      .cal-frame { width: 410px; height: 600px; transform: scale(var(--cal-s)); transform-origin: 0 0; }
    }

    /* Móvil: póster como franja arriba (del logo al DJ) y el calendario debajo. Alto fijo que cubre el mes y la zona
       horaria sin blanco de sobra; al elegir día, la lista de horarios se desplaza dentro de Calendly. */
    @media (max-width: 899px) {
      .consult { padding: 1.25rem 16px 3rem; }
      .head-kicker { margin-bottom: 0.6rem; }
      .head-h1 { font-size: clamp(2rem, 8.5vw, 2.5rem); }
      .head-sub { font-size: 0.98rem; margin-top: 0.6rem; }
      .head-call { display: block; margin: 0.35rem 0 0; }
      .cal-card { grid-template-columns: 1fr; border-radius: 14px; max-width: 560px; }
      .cal-poster { width: 100%; height: auto; aspect-ratio: 941 / 760; object-position: 50% 0; }
      .cal-frame { width: 100%; height: 600px; }
    }
  </style>
</Noir>

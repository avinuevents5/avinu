---
import Noir from '../../layouts/Noir.astro';

// Términos generales del sitio + SMS (registro A2P 10DLC de Twilio)
// (sin las cláusulas del contrato de servicio antiguo).
const TERMS_UPDATED = 'November 5, 2026';
type SiteBlock = { p?: string; strong?: string; label?: string };
const siteTerms: { title: string; blocks: SiteBlock[] }[] = [
  {
    title: '1. Our Services',
    blocks: [
      { p: 'Avinu Events provides professional entertainment and event production services, including DJ entertainment, live musicians, ceremony entertainment, lighting, audiovisual production, and related event services.' },
      { p: 'Service availability, pricing, and specific deliverables depend on the event requirements and the terms of each individual proposal or agreement.' },
    ],
  },
  {
    title: '2. Inquiries and Proposals',
    blocks: [
      { p: 'Submitting an inquiry or requesting a quotation does not constitute a confirmed booking.' },
      { p: 'Proposals are subject to availability, pricing confirmation, and any applicable service agreements.' },
      { p: 'An event booking is confirmed only according to the terms specified in the applicable booking agreement.' },
    ],
  },
  {
    title: '3. Event Bookings and Payments',
    blocks: [
      { p: 'Payment schedules, deposits, cancellation terms, and other event-specific conditions will be communicated through the applicable proposal or service agreement.' },
    ],
  },
  {
    title: '4. SMS Messaging Terms',
    blocks: [
      { label: 'Program Name:', p: 'Avinu Events SMS Notifications' },
      { p: 'By expressly opting in to receive SMS communications from Avinu Events, you agree to receive text messages related to your event inquiry, consultation scheduling, proposal updates, booking confirmations, event coordination, appointment reminders, and customer support.' },
      { p: 'Promotional messages will be sent only if you have separately opted in to receive marketing SMS communications.' },
      { label: 'Message Frequency:', p: 'Message frequency varies depending on your event planning activity and interactions with our team.' },
      { label: 'Message and Data Rates:', p: 'Message and data rates may apply.' },
      { label: 'Opt-Out:', p: 'You can cancel the SMS service at any time. Reply STOP to any message to unsubscribe. After you send STOP, you will receive confirmation of your unsubscribe request. You will no longer receive messages from that SMS program unless you opt in again.' },
      { label: 'Help:', p: 'For assistance, reply HELP to any message, email info@avinuevents.com, or call 754-547-4415.' },
      { label: 'Consent:', p: 'Consent to receive SMS messages is not a condition of purchasing services from Avinu Events.' },
      { label: 'Carrier Disclaimer:', p: 'Carriers are not liable for any delayed or undelivered messages.' },
    ],
  },
  {
    title: '5. Website and Client Portal',
    blocks: [
      { p: 'Our website and client portal may allow customers to review services, manage event preferences, view proposals, and communicate event planning information.' },
      { p: 'Customers are responsible for providing accurate information and maintaining the confidentiality of their portal access credentials.' },
    ],
  },
  {
    title: '6. Intellectual Property',
    blocks: [
      { p: 'Website content, branding, designs, photographs, and other materials owned by Avinu Events may not be reproduced or distributed without authorization.' },
      { p: 'Third-party materials remain the property of their respective owners.' },
    ],
  },
  {
    title: '7. Limitation of Liability',
    blocks: [
      { p: 'To the extent permitted by applicable law, Avinu Events is not responsible for website interruptions, technical errors, or indirect damages arising from use of the website.' },
      { p: 'Nothing in these Terms limits rights or remedies that cannot legally be excluded.' },
    ],
  },
  {
    title: '8. Changes to These Terms',
    blocks: [
      { p: 'We may revise these Terms & Conditions periodically. Updated terms will be published on this page with the corresponding revision date.' },
    ],
  },
];
---

<Noir
  title="Terms and Conditions"
  description="Terms and conditions for the Avinu Events website, SMS program, and event services provided by Levine Events d/b/a Avinu Events."
  robots="noindex, follow"
>
  <!-- ░░ PAGE HEADER ░░ -->
  <section class="page-head">
    <p class="eyebrow head-kicker">Legal</p>
    <h1 class="head-h1">Terms &amp; <span class="ital">Conditions</span></h1>
    <p class="head-sub">Last updated: {TERMS_UPDATED}</p>
  </section>

  <!-- ░░ LEGAL BODY ░░ -->
  <section class="legal">
    <div class="legal-inner">
      <div class="parties" data-reveal>
        <p>Welcome to Avinu Events. Avinu Events is a brand of Levine Events (&ldquo;Avinu Events,&rdquo; &ldquo;Levine Events,&rdquo; &ldquo;we,&rdquo; or &ldquo;us&rdquo;). By accessing our website, submitting an inquiry, requesting a proposal, or using our services, you agree to the following Terms &amp; Conditions.</p>
      </div>

      {siteTerms.map((s) => (
        <article class="clause" id={s.title.startsWith('4.') ? 'sms-terms' : undefined} data-reveal>
          <h2 class="clause-title">{s.title}</h2>
          {s.blocks.map((b) => (b.label ? <p><strong class="lbl">{b.label}</strong> {b.p}</p> : <p>{b.p}</p>))}
          {s.title.startsWith('4.') && (
            <p>For information about how we collect and protect your information, please review our <a href="/privacy-policy/">Privacy Policy</a>.</p>
          )}
        </article>
      ))}

      <article class="clause" data-reveal>
        <h2 class="clause-title">9. Contact Information</h2>
        <p>For questions about these Terms &amp; Conditions, please contact:</p>
        <p><strong class="lbl">Avinu Events</strong> (Levine Events)<br />
          Website: <a href="https://www.avinuevents.com">www.avinuevents.com</a><br />
          Email: <a href="mailto:info@avinuevents.com">info@avinuevents.com</a><br />
          Phone: <a href="tel:+17545474415">754-547-4415</a></p>
      </article>

    </div>
  </section>

  <!-- ░░ CLOSING CTA ░░ -->
  <section class="band midnight cta-band">
    <div class="cta-inner" data-reveal>
      <p class="eyebrow">Questions?</p>
      <h2 class="cta-h2">Let's produce <span class="ital">yours</span></h2>
      <p class="cta-sub">Reach out and we'll walk you through every detail of your agreement.</p>
      <div class="cta-actions">
        <a class="btn-primary" href="/get-a-quote/">Get a Quote</a>
      </div>
    </div>
  </section>

  <style>
    .ital { font-style: italic; font-weight: 400; letter-spacing: -0.01em; }

    .page-head { max-width: 56rem; margin: 0 auto; padding: clamp(3.5rem, 8vh, 6rem) clamp(1.5rem, 6vw, 6rem) clamp(1.5rem, 3vh, 2.5rem); text-align: center; }
    .head-kicker { display: block; margin-bottom: 1.3rem; }
    .head-h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); letter-spacing: -0.03em; }
    .head-sub { color: var(--muted-text); font-size: clamp(1rem, 1.4vw, 1.15rem); max-width: 40rem; margin: 1.4rem auto 0; }

    .legal { padding: clamp(2rem, 4vh, 3rem) 1.5rem clamp(3rem, 6vh, 5rem); }
    .legal-inner { max-width: 48rem; margin: 0 auto; }
    .parties { padding-bottom: 2rem; margin-bottom: 1rem; border-bottom: 1px solid var(--line); }
    .parties p, .clause p { color: var(--muted-text); font-size: 0.98rem; line-height: 1.75; margin: 0 0 1rem; }
    .parties strong { color: var(--fg); font-weight: 700; }

    .clause { padding: 2rem 0; border-bottom: 1px solid var(--line); }
    .clause:last-child { border-bottom: none; }
    .lbl { color: var(--fg); font-weight: 700; }
    .clause a { color: var(--accent-ink); }
    .clause-title { font-size: clamp(1.3rem, 2.4vw, 1.7rem); color: var(--fg); margin-bottom: 1rem; }

    .band { padding: clamp(4.5rem, 9vh, 7rem) 1.5rem; }
    .band > * { max-width: var(--maxw); margin-left: auto; margin-right: auto; }
    .midnight { background: linear-gradient(180deg, var(--midnight-deep), var(--midnight) 50%, var(--midnight-deep)); }

    .cta-band { text-align: center; }
    .cta-inner { max-width: 44rem; }
    .cta-band .eyebrow { display: block; }
    .cta-h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin-top: 0.7rem; }
    .cta-sub { color: var(--muted-text); margin: 1.2rem 0 2rem; }
    .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    @media (prefers-reduced-motion: no-preference) {
      :global(html.js) [data-reveal] { opacity: 0; }
    }
  </style>

  <script>
    import { animate, inView } from 'motion';
    inView('[data-reveal]', (el) => {
      animate(el, { opacity: [0, 1], y: [28, 0] }, { duration: 0.7, ease: [0.16, 1, 0.3, 1] });
    }, { margin: '0px 0px -8% 0px' });
  </script>
</Noir>

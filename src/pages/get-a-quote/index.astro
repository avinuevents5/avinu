---
import Noir from '../../layouts/Noir.astro';
import { phone } from '../../data/home';

const tel = phone.replace(/[^+\d]/g, '');

// Formulario del CRM (avinu-crm). Cambiar aquí cuando tenga dominio propio (p. ej. app.avinuevents.com).
const crmOrigin = (import.meta.env.PUBLIC_CRM_ORIGIN || 'https://avinu-crm.vercel.app').replace(/\/+$/, '');
const inquireUrl = `${crmOrigin}/inquire?embed=1`;
---

<Noir
  title="Contact us"
  description="Get a quote for your event from Avinu Music & Productions — South Florida's premier event-production house. DJs, ceremony singers, live musicians, lighting and full production. Call +1 754-547-4415."
>
  <!-- ░░ PLAN YOUR EVENT ░░ — formulario del CRM integrado en la página, a todo el ancho -->
  <section class="quote">
    <div class="quote-grid">
      <div class="quote-main">
        <header class="page-head">
          <p class="eyebrow head-kicker">Get a quote</p>
          <h1 class="head-h1">Let's Plan Your <span class="ital">Event</span></h1>
          <p class="head-sub">Explore your options with a personalized proposal. <span class="head-call">Prefer to talk? <a href={`tel:${tel}`}>Call {phone}</a></span></p>
        </header>
        <iframe
          id="avinu-inquire"
          src={inquireUrl}
          class="inq-frame"
          title="Plan your event — Avinu Events"
          loading="eager"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Altura automática del iframe y scroll al inicio del formulario en cada paso -->
  <script is:inline define:vars={{ crmOrigin }}>
    (function () {
      var frame = document.getElementById('avinu-inquire');
      if (!frame) return;
      // Dónde está el formulario respecto a la pantalla: el CRM lo usa para abrir
      // ventanas (p. ej. el calendario de la fecha) en el centro de lo que se ve.
      function sendViewport() {
        if (!frame.contentWindow) return;
        frame.contentWindow.postMessage(
          { type: 'avinu-inquire-viewport', top: frame.getBoundingClientRect().top, height: window.innerHeight },
          crmOrigin
        );
      }
      var ticking = false;
      function onMove() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { ticking = false; sendViewport(); });
      }
      window.addEventListener('scroll', onMove, { passive: true });
      window.addEventListener('resize', onMove);
      window.addEventListener('message', function (e) {
        if (e.origin !== crmOrigin || !e.data || typeof e.data !== 'object') return;
        if (e.data.type === 'avinu-inquire-height' && typeof e.data.height === 'number') {
          frame.style.height = Math.max(480, Math.ceil(e.data.height)) + 'px';
        } else if (e.data.type === 'avinu-inquire-wide') {
          // Paso final (gracias + agenda): sin el encabezado grande, para que el calendario entre en la pantalla.
          var grid = frame.closest('.quote-grid');
          if (grid) grid.classList.toggle('is-done', !!e.data.wide);
        } else if (e.data.type === 'avinu-inquire-viewport-request') {
          sendViewport();
        } else if (e.data.type === 'avinu-inquire-scroll') {
          var top = frame.getBoundingClientRect().top + window.scrollY - 90;
          if (window.scrollY > top) window.scrollTo({ top: top, behavior: 'smooth' });
        }
      });
    })();
  </script>

  <!-- ░░ CLOSING CTA ░░ -->
  <section class="band midnight cta-band">
    <div class="cta-inner" data-reveal>
      <p class="eyebrow">Prefer to call?</p>
      <h2 class="cta-h2">We're here to <span class="ital">help</span></h2>
      <p class="cta-sub">Reach our team directly and we'll start planning your event today.</p>
      <div class="cta-actions">
        <a class="btn-primary" href={`tel:${tel}`}>Call {phone}</a>
      </div>
    </div>
  </section>

  <style>
    .ital { font-style: italic; font-weight: 400; letter-spacing: -0.01em; }

    /* ── LAYOUT: formulario a todo el ancho (laptop ≈ 1060px, pantallas grandes hasta 1200px) ── */
    .quote { padding: clamp(1.5rem, 4.5vh, 3.25rem) var(--gutter) clamp(4rem, 8vh, 6rem); }
    .quote-grid { max-width: clamp(1060px, 75vw, 1200px); margin: 0 auto; }
    .quote-main { min-width: 0; }
    .quote-grid.is-done .page-head { display: none; }
    .quote-grid.is-done .inq-frame { margin-top: 0; }

    .page-head { max-width: 44rem; }
    .head-kicker { display: block; margin-bottom: 1rem; }
    .head-h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); letter-spacing: -0.03em; line-height: 1.02; }
    .head-sub { color: var(--muted-text); font-size: clamp(1rem, 1.4vw, 1.15rem); margin: 0.9rem 0 0; }
    /* Teléfono en la misma línea que el subtítulo (una línea menos antes del formulario) */
    .head-call { margin-left: 0.6rem; font-size: 0.95rem; white-space: nowrap; }
    .head-call a { color: var(--fg); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

    /* Formulario: sin caja, mismo marfil que la página */
    .inq-frame { display: block; width: 100%; height: 760px; border: 0; margin-top: clamp(1rem, 2.2vh, 1.5rem); background: transparent; transition: height 0.25s ease; }

    .band { padding: clamp(4.5rem, 9vh, 7rem) 1.5rem; }
    .band > * { max-width: var(--maxw); margin-left: auto; margin-right: auto; }
    .midnight { background: linear-gradient(180deg, var(--midnight-deep), var(--midnight) 50%, var(--midnight-deep)); }
    .cta-band { text-align: center; }
    .cta-inner { max-width: 44rem; }
    .cta-band .eyebrow { display: block; }
    .cta-h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin-top: 0.7rem; }
    .cta-sub { color: var(--muted-text); margin: 1.2rem 0 2rem; }
    .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    @media (prefers-reduced-motion: no-preference) {
      :global(html.js) [data-reveal] { opacity: 0; }
    }
  </style>

  <script>
    import { animate, inView } from 'motion';
    inView('[data-reveal]', (el) => {
      animate(el, { opacity: [0, 1], y: [30, 0] }, { duration: 0.8, ease: [0.16, 1, 0.3, 1] });
    }, { margin: '0px 0px -10% 0px' });
  </script>
</Noir>

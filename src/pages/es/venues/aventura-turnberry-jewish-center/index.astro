const srcset = (n) => { const p = MEDIA.photos[n]; return `${src(n, 800)} 800w, ${src(n, 1600)} ${Math.min(1600, p.w)}w`; };
function img(n, { sizes = '100vw', lazy = true, cls = '' } = {}) {
  const p = MEDIA.photos[n]; const el = new Image();
  el.src = src(n, 800); el.srcset = srcset(n); el.sizes = sizes; el.alt = p.alt;
  el.width = Math.min(1600, p.w); el.height = Math.round(el.width * p.h / p.w); el.decoding = 'async';
  if (lazy) el.loading = 'lazy'; if (cls) el.className = cls; return el;
}
function mountVideo(container, v, poster, { eager = false } = {}) {
  // Solo si hay video real y el usuario no pidió reducir movimiento / ahorrar datos.
  if (!v || reduced || saveData) return null;
  const video = document.createElement('video');
  Object.assign(video, { muted: true, loop: true, playsInline: true, autoplay: true, preload: eager ? 'auto' : 'none', poster });
  video.setAttribute('muted', ''); video.setAttribute('aria-hidden', 'true');
  if (v.webm) video.append(Object.assign(document.createElement('source'), { src: v.webm, type: 'video/webm' }));
  if (v.mp4) video.append(Object.assign(document.createElement('source'), { src: v.mp4, type: 'video/mp4' }));
  video.addEventListener('playing', () => video.classList.add('ready'), { once: true });
  container.append(video);
  return video;
}

/* ═══════════════ Reproductor común: play solo visible + botón de pausa ═══════════════ */
const ICON_PAUSE = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>';
const ICON_SOUND = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor" stroke="none"/><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"/></svg>';
const ICON_MUTED = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor" stroke="none"/><path d="M16 9l5 6M21 9l-5 6"/></svg>';
const ICON_PLAY = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5l12 7-12 7z"/></svg>';
const autoplayOK = !reduced && !saveData;

  <span class="scroll-cue" aria-hidden="true"></span>
</section>

<!-- ═════ INTRO EDITORIAL ═════ -->
<section class="intro" id="ballroom">
  <div class="wrap intro-grid">
    <div class="intro-text">
      <span class="kicker reveal">El salón</span>
      <h2 class="reveal d1">Un salón, <em>todo tipo</em> de celebraciones</h2>
      <p class="reveal d2">En el corazón de Aventura, ATJC reúne la sinagoga, el salón y la cocina en un mismo lugar. Aquí se celebran bodas, bar y bat mitzvahs, brit milá, brunches de Shabat y galas de la comunidad.</p>
      <p class="reveal d3">La decoración, la iluminación y el catering se coordinan en casa: las familias planean con un solo equipo en vez de cinco.</p>
    </div>
    <figure class="intro-figure intro-a img-reveal reveal">
      <span class="note-badge">Ideal: salón renovado</span>
      <img src="/venues/atjc/media/ballroom-led-floor-800.webp" srcset="/venues/atjc/media/ballroom-led-floor-800.webp 800w, /venues/atjc/media/ballroom-led-floor-1600.webp 887w" sizes="(max-width: 900px) 80vw, 40vw" width="800" height="923" alt="El salón de ATJC montado para una recepción, con pista de baile LED iluminada" loading="lazy" decoding="async" />
      <figcaption>El salón, montado para una recepción</figcaption>
    </figure>
    <figure class="intro-figure intro-b img-reveal reveal d2">
      <img src="/venues/atjc/media/tablescape-florals-800.webp" width="768" height="1024" alt="Una mesa con rosas rosadas, cristalería y vajilla floral" loading="lazy" decoding="async" />
    </figure>
    <div class="intro-stats reveal">
      <div><b>650</b><span>Invitados en el salón</span></div>
      <div><b>2,000+</b><span>Catering externo</span></div>
      <div><b>35</b><span>Años de simjás</span></div>
    </div>
  </div>
</section>

<!-- ═════ CELEBRATIONS (selector) ═════ -->
<section class="celebrate" id="celebrations">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="kicker reveal">Celebraciones</span>

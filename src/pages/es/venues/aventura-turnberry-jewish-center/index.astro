  const btn = document.createElement('button'); btn.className = 'vp-btn'; ctrls.append(btn);
  if (v.audio) {
    const snd = document.createElement('button'); snd.className = 'vp-btn';
    const paintSnd = () => { snd.innerHTML = video.muted ? ICON_MUTED : ICON_SOUND; snd.setAttribute('aria-label', (video.muted ? 'Activar sonido' : 'Silenciar') + ': ' + v.label); snd.setAttribute('aria-pressed', String(!video.muted)); };
    snd.addEventListener('click', () => { video.muted = !video.muted; if (!video.muted && video.paused) { st.userPaused = false; video.play().catch(() => {}); } paintSnd(); });
    video.addEventListener('volumechange', paintSnd); paintSnd(); ctrls.append(snd);
  }
  el.append(video, ctrls);

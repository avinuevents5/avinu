      <div class="tabs" role="tablist" aria-label="Tipo de celebración" id="tabs"></div>
    </div>
    <div class="stage" id="stage-panel" role="tabpanel" tabindex="0">
      <figure class="stage-figure"><div class="stage-media" id="stage-media"></div><figcaption class="stage-cap" id="stage-cap"></figcaption></figure>
      <div class="stage-copy" id="stage-copy"></div>
    </div>
  </div>
</section>

<!-- ═════ BALLROOM FILM / TRANSFORMATIONS ═════ -->
<section class="film" id="film" aria-labelledby="film-title">

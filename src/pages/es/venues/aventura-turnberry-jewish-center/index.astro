function vplayer(key, { cls = '' } = {}) {
  const v = MEDIA.videos[key];
  const el = document.createElement('div'); el.className = 'vp ' + cls;
  const video = document.createElement('video');
  Object.assign(video, { muted: true, loop: true, playsInline: true, preload: 'none', poster: v.poster });

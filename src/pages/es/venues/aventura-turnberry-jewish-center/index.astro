  if (m.type === 'photo') {
    panel.className = 'comp comp-photo';
    const im = img(m.photo, { sizes: '(max-width: 900px) 100vw, 56vw', lazy: i !== 0 });
    const setPos = () => { im.style.objectPosition = isMobile.matches ? (m.posMobile || m.pos) : m.pos; };
    setPos(); isMobile.addEventListener('change', setPos);
    panel.append(im);
  } else {
    panel.className = 'comp comp-reel';
    const pl = vplayer(m.video); pl.setActive(false); stagePlayers[c.id] = pl; panel.append(pl.el);
  }
  stageMedia.append(panel); stagePanels[c.id] = panel;
}
CELEBRATIONS.forEach((c, i) => {
  const b = document.createElement('button');
  Object.assign(b, { className: 'tab', id: 'tab-' + c.id, role: 'tab' });
  b.setAttribute("aria-label", c.label);
  b.innerHTML = `<span class="t-full">${c.label}</span><span class="t-short" aria-hidden="true">${c.short}</span>`;
  b.setAttribute('role', 'tab'); b.setAttribute('aria-controls', 'stage-panel'); b.setAttribute('aria-selected', i === 0); b.tabIndex = i === 0 ? 0 : -1;
  b.addEventListener('click', () => selectCelebration(i, true));
  tabsEl.append(b);
  buildPanel(c, i);
});
tabsEl.addEventListener('keydown', e => {
  const tabs = [...tabsEl.children], cur = tabs.findIndex(t => t.getAttribute('aria-selected') === 'true');
  let n = null;
  if (e.key === 'ArrowRight') n = (cur + 1) % tabs.length; if (e.key === 'ArrowLeft') n = (cur - 1 + tabs.length) % tabs.length;
  if (e.key === 'Home') n = 0; if (e.key === 'End') n = tabs.length - 1;
  if (n !== null) { e.preventDefault(); selectCelebration(n, true); tabs[n].focus(); }
});
function selectCelebration(i, animate) {
  const c = CELEBRATIONS[i];
  [...tabsEl.children].forEach((t, j) => { t.setAttribute('aria-selected', j === i); t.tabIndex = j === i ? 0 : -1; });
  $('#stage-panel').setAttribute('aria-labelledby', 'tab-' + c.id);
  Object.entries(stagePanels).forEach(([id, el]) => el.classList.toggle('on', id === c.id));
  Object.entries(stagePlayers).forEach(([id, pl]) => pl.setActive(id === c.id));
  stageMedia.style.setProperty('--ar', c.media.ar);
  stageMedia.classList.toggle('is-photo', c.media.type === 'photo');
  if (animate && !reduced) { stageCap.classList.add('out'); setTimeout(() => { stageCap.textContent = c.media.caption; stageCap.classList.remove('out'); }, 300); }
  else stageCap.textContent = c.media.caption;
  const render = () => {
    stageCopy.innerHTML = `<h3>${c.title}</h3><p>${c.text}</p><ul>${c.points.map(p => `<li>${p}</li>`).join('')}</ul><a class="btn btn-gold" href="#plan">Planea ${c.id === 'galas' ? 'tu gala' : c.id === 'weddings' ? 'tu boda' : 'tu mitzvah'} en ATJC</a>`;
    stageCopy.classList.remove('out');
  };
  if (animate && !reduced) { stageCopy.classList.add('out'); setTimeout(render, 260); } else render();
}
selectCelebration(0, false);

/* ═══════════════ FILM / TRANSFORMACIONES ═══════════════ */
const filmFrame = $('#film-frame'), filmSteps = $('#film-steps');
const filmVideo = MEDIA.film.video ? mountVideo(filmFrame, MEDIA.film.video, src('ballroom-led-floor')) : null;
if (filmVideo) {
  $('#film-status').remove();
  new IntersectionObserver(([e]) => { if (e.isIntersecting) { filmVideo.preload = 'auto'; filmVideo.play().catch(() => {}); } else filmVideo.pause(); }, { threshold: .35 }).observe(filmFrame);
}
const filmPlayers = [];
const filmImgs = MOMENTS.map((m, i) => {
  if (m.video) {
    const pl = vplayer(m.video); pl.setActive(false); filmPlayers[i] = pl;
    filmFrame.prepend(pl.el); return [pl.el];   // fondo liso #171513, sin desenfoque
  }
  const im = img(m.photo, { sizes: '(max-width: 900px) 100vw, 80vw' }); filmFrame.prepend(im);
  if (m.wide) { im.classList.add('wide'); im.style.objectPosition = m.pos || '50% 50%'; }
  if (m.plain) return [im];   // fondo liso #171513, sin desenfoque
  const fill = img(m.photo, { cls: 'fill' }); fill.alt = ''; fill.srcset = ''; fill.src = src(m.photo, 800); filmFrame.prepend(fill); return [fill, im];
});
MOMENTS.forEach((m, i) => {
  const b = document.createElement('button'); b.className = 'film-step'; b.setAttribute('aria-pressed', i === 0);
  b.innerHTML = `<b>${m.title}</b><span>${m.text}</span>`;
  b.addEventListener('click', () => setMoment(i)); filmSteps.append(b);
  b.addEventListener('pointerdown', () => filmSteps.classList.add('mouse'));
  b.addEventListener('keydown', () => filmSteps.classList.remove('mouse'));
});
function setMoment(i) {
  filmImgs.forEach((pair, j) => pair.forEach(im => im.classList.toggle('on', j === i)));
  filmPlayers.forEach((pl, j) => pl && pl.setActive(j === i));
  [...filmSteps.children].forEach((b, j) => b.setAttribute('aria-pressed', j === i));
}
setMoment(0);

/* ═══════════════ GALERÍA + LIGHTBOX ═══════════════ */
const grid = $('#grid'), chips = $('#chips');
GALLERY.forEach((n, i) => {
  const p = MEDIA.photos[n]; const b = document.createElement('button');
  b.className = 'tile reveal'; b.dataset.cat = p.cat; b.dataset.n = n;
  b.setAttribute('aria-label', `Abrir foto: ${p.cap}`);
  b.append(img(n, { sizes: '(max-width: 900px) 50vw, 33vw' }));
  const cap = document.createElement('span'); cap.className = 'cap'; cap.textContent = p.cap; b.append(cap);
  b.addEventListener('click', () => openLb(n, b));
  grid.append(b);
});
if (!reduced) { const go = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); go.unobserve(e.target); } }), { rootMargin: '0px 0px -5% 0px' }); grid.querySelectorAll('.tile').forEach(t => go.observe(t)); }
else grid.querySelectorAll('.tile').forEach(t => t.classList.add('in'));
GALLERY_CATS.forEach(([id, label], i) => {
  const b = document.createElement('button'); b.className = 'chip'; b.textContent = label; b.setAttribute('aria-pressed', i === 0);
  b.addEventListener('click', () => {
    [...chips.children].forEach(c => c.setAttribute('aria-pressed', c === b));
    grid.querySelectorAll('.tile').forEach(t => t.classList.toggle('hide', id !== 'all' && t.dataset.cat !== id));
  });
  chips.append(b);
});

const lb = $('#lb'), lbImg = $('#lb-img'), lbCap = $('#lb-cap'), lbCount = $('#lb-count');
let lbList = [], lbIdx = 0, lbOpener = null;
function visibleList() { return [...grid.querySelectorAll('.tile:not(.hide)')].map(t => t.dataset.n); }
function showLb(i, dir = 0) {
  lbIdx = (i + lbList.length) % lbList.length; const n = lbList[lbIdx], p = MEDIA.photos[n];
  const apply = () => {
    lbImg.src = src(n, 1600); lbImg.alt = p.alt;
    lbCap.innerHTML = `${p.cap}<small>Foto: ${p.credit}</small>`;
    lbCount.textContent = `${lbIdx + 1} / ${lbList.length}`;
    lbImg.classList.remove('fade');
  };
  if (dir && !reduced) { lbImg.classList.add('fade'); setTimeout(apply, 180); } else apply();
  // Precarga la siguiente
  const nx = lbList[(lbIdx + 1) % lbList.length]; new Image().src = src(nx, 1600);
}
function openLb(n, opener) { lbList = visibleList(); lbOpener = opener; lb.showModal(); showLb(lbList.indexOf(n)); $('#lb-close').focus(); }
function closeLb() { lb.close(); }
lb.addEventListener('close', () => lbOpener && lbOpener.focus());
$('#lb-close').addEventListener('click', closeLb);
$('#lb-prev').addEventListener('click', () => showLb(lbIdx - 1, -1));
$('#lb-next').addEventListener('click', () => showLb(lbIdx + 1, 1));
lb.addEventListener('keydown', e => {
  if (e.key === 'ArrowRight') { e.preventDefault(); showLb(lbIdx + 1, 1); }
  if (e.key === 'ArrowLeft') { e.preventDefault(); showLb(lbIdx - 1, -1); }
});
lb.addEventListener('click', e => { if (e.target === lb || e.target.classList.contains('lb-inner')) closeLb(); });
// Deslizar en móvil
let sx = null;
$('#lb-fig').addEventListener('pointerdown', e => { sx = e.clientX; });
$('#lb-fig').addEventListener('pointerup', e => { if (sx === null) return; const dx = e.clientX - sx; sx = null; if (Math.abs(dx) > 50) showLb(lbIdx + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1); });

/* ═══════════════ CUISINE: tira de platos (control manual, sin auto-play) ═══════════════ */
const courses = $('#courses');
COURSES.forEach(n => {
  if (typeof n === 'object') {
    const v = MEDIA.videos[n.video]; const f = document.createElement('figure'); f.className = 'course course-v';
    const w = document.createElement('div'); w.className = 'ph-wrap'; w.append(vplayer(n.video).el);
    f.append(w); const c = document.createElement('figcaption'); c.innerHTML = `${v.cap}<small>Video \u00b7 Premier Event Catering</small>`; f.append(c);
    courses.append(f); return;
  }
  const p = MEDIA.photos[n]; const f = document.createElement('figure'); f.className = 'course';
  const w = document.createElement('div'); w.className = 'ph-wrap'; w.append(img(n, { sizes: '(max-width: 900px) 78vw, 30vw' }));
  f.append(w); const c = document.createElement('figcaption'); c.innerHTML = `${p.cap}<small>Premier Event Catering</small>`; f.append(c);
  courses.append(f);
});
const step = () => courses.querySelector('.course').getBoundingClientRect().width + 19;
$('#courses-prev').addEventListener('click', () => courses.scrollBy({ left: -step(), behavior: reduced ? 'auto' : 'smooth' }));
$('#courses-next').addEventListener('click', () => courses.scrollBy({ left: step(), behavior: reduced ? 'auto' : 'smooth' }));
courses.addEventListener('keydown', e => { if (e.key === 'ArrowRight') courses.scrollBy({ left: step() }); if (e.key === 'ArrowLeft') courses.scrollBy({ left: -step() }); });

/* ═══════════════ VOICES: reseñas con control manual ═══════════════ */
const quote = $('#quote'), quoteWho = $('#quote-who'), dots = $('#q-dots');
let qi = 0;
REVIEWS.forEach((r, i) => { const d = document.createElement('button'); d.setAttribute('aria-label', `Reseña ${i + 1}: ${r.who}`); d.addEventListener('click', () => showQ(i)); dots.append(d); });
function showQ(i) {
  qi = (i + REVIEWS.length) % REVIEWS.length; const r = REVIEWS[qi];
  const apply = () => { quote.textContent = `“${r.q}”`; quoteWho.textContent = r.who; quote.classList.remove('fade'); };
  if (!reduced && quote.textContent) { quote.classList.add('fade'); setTimeout(apply, 300); } else apply();
  [...dots.children].forEach((d, j) => d.setAttribute('aria-current', j === qi));
}
$('#q-prev').addEventListener('click', () => showQ(qi - 1));
$('#q-next').addEventListener('click', () => showQ(qi + 1));
showQ(0);

/* ═══════════════ ?notes: marca el material pendiente (uso interno) ═══════════════ */
if (new URLSearchParams(location.search).has('notes')) document.body.classList.add('notes');
</script>
</body>
</html>

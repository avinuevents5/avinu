<main id="main">
<!-- ═════ HERO ═════ -->
<section class="hero" id="top" aria-label="Aventura Turnberry Jewish Center">
  <div class="hero-media" id="hero-media">
    <img id="hero-poster" src="/venues/atjc/media/wedding-chuppah-1600.webp" srcset="/venues/atjc/media/wedding-chuppah-800.webp 800w, /venues/atjc/media/wedding-chuppah-1600.webp 1600w" sizes="100vw" width="1600" height="1066" alt="Una pareja bajo una jupá floral en el salón de ATJC" fetchpriority="high" decoding="async" />
  </div>
  <span class="note-badge" style="top:auto;bottom:1rem;right:1rem">Video oficial pendiente (el hero ya acepta MP4/WebM)</span>
  <div class="hero-copy">
    <a class="hero-back" href="/venues/">Todos los venues</a>
    <span class="kicker">Aventura, Florida · Celebraciones desde 1990</span>
    <h1><span>Aventura</span> <span>Turnberry</span> <em>Jewish Center</em></h1>
    <p class="hero-lead">Un salón para hasta 650 invitados, cocina kosher preparada en casa por Premier Event Catering y un equipo que lleva más de tres décadas recibiendo las simjás del sur de Florida.</p>
    <div class="hero-actions">
      <a class="btn btn-gold" href="#plan">Planea tu celebración <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>

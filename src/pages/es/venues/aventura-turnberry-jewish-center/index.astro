      </div>
      <p class="reveal d2" style="max-width:42ch;color:rgba(255,255,255,.65);margin:0">El mismo salón pasa de la ceremonia a la recepción y al lounge de la noche. Elige un momento para ver cómo cambia.</p>
    </div>
    <div class="film-frame reveal" id="film-frame">
      <span class="film-status" id="film-status">Muy pronto, el video oficial del salón</span>
      <span class="note-badge">Slot listo para video del venue</span>
    </div>
    <div class="film-steps" id="film-steps" role="group" aria-label="Momentos de la noche"></div>

  </div>
</section>

<!-- ═════ GALLERY ═════ -->

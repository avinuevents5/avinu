---
import SpeaksLine from '../../components/SpeaksLine.astro';
import { getCollection, render } from 'astro:content';
import Noir from '../../layouts/Noir.astro';
import ConnectCTA from '../../components/ConnectCTA.astro';

export async function getStaticPaths() {
  const djs = await getCollection('djs');
  return djs.map((dj) => ({
    params: { slug: dj.id },
    props: { dj },
  }));
}

const { dj } = Astro.props;
const { Content } = await render(dj);
const d = dj.data;

// Lead the hero with the most cinematic image available — the first gallery shot
// (often a full-bleed action photo); fall back to the roster portrait.
const heroImg = d.gallery?.[0] ?? d.photo;

// "In Distinguished Company": on the live site only entries Mark confirmed, with a
// photo we have rights to. The local preview (astro dev) also shows the pending
// ones as placeholders so the layout can be reviewed.
const isPreview = import.meta.env.DEV;
const company = (d.company ?? []).filter(
  (c) => isPreview || (c.confirmed && c.photo && c.photoRights),
);
const initials = (name: string) =>
  name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');

// Other DJs for the footer roster strip.
const others = (await getCollection('djs'))
  .filter((o) => o.id !== dj.id)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Noir title={d.title} description={d.summary ?? `${d.title}, an Avinu DJ in South Florida.`}>
  <!-- HERO IMAGE + NAME -->
  <section class="dj-hero">
    <div class="dj-hero-img" style={`background-image:url('${heroImg}')`}></div>
    <div class="dj-hero-scrim"></div>
    <div class="dj-hero-content">
      <a class="back-link" href="/best-djs-in-south-florida/">All DJs</a>
      {d.role && <p class="eyebrow">{d.role}</p>}
      <h1>{d.title}</h1>
      {d.languages && d.languages.length > 0 && <SpeaksLine languages={d.languages} tone="light" />}
    </div>
  </section>

  <!-- BIO + STATS -->
  <section class="band bio-band">
    <div class="bio-grid">
      <article class="bio" data-reveal>
        <Content />
      </article>
      <aside class="stats" data-reveal>
        {d.specialties && d.specialties.length > 0 && (
          <div class="stat-block">
            <p class="eyebrow">Specializes in</p>
            <ul class="specs">
              {d.specialties.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        )}
        <a class="btn-primary stat-cta" href="/get-a-quote/">Book {d.title}</a>
      </aside>
    </div>
  </section>

  <!-- IN DISTINGUISHED COMPANY -->
  {company.length > 0 && (
    <section class="band company-band" aria-labelledby="company-title">
      <header class="band-head company-head" data-reveal>
        <p class="eyebrow">On the international stage</p>
        <h2 id="company-title">In Distinguished Company</h2>
        <span class="company-rule" aria-hidden="true"></span>
        {d.companyIntro && <p class="company-sub">{d.companyIntro}</p>}
        {isPreview && (
          <p class="company-draft-note">
            Internal preview — pending entries are hidden on the live site until Mark confirms the work and a licensed photo is added.
          </p>
        )}
      </header>
      <ul class="company" role="list" data-reveal-group>
        {company.map((c) => {
          const live = !!(c.confirmed && c.photo && c.photoRights);
          return (
            <li class="company-item">
              <figure>
                <div class="company-photo">
                  {c.photo ? (
                    <img src={c.photo} alt={c.name} width="600" height="800" loading="lazy" decoding="async" />
                  ) : (
                    <div class="company-placeholder" role="img" aria-label={`Photo pending: ${c.name}`}>
                      <span class="ph-mono">{initials(c.name)}</span>
                      <span class="ph-label">Photo pending</span>
                    </div>
                  )}
                </div>
                <figcaption>
                  <span class="company-name">{c.name}</span>
                  {c.confirmed && c.note && <span class="company-note">{c.note}</span>}
                  {isPreview && !live && (
                    <span class="company-pending">
                      {!c.confirmed ? 'Awaiting Mark’s confirmation' : !c.photo ? 'Needs a photo' : 'Needs photo rights'}
                    </span>
                  )}
                </figcaption>
              </figure>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <!-- VIDEOS -->
  {d.videos && d.videos.length > 0 && (
    <section class="band videos-band">
      <header class="band-head" data-reveal>
        <p class="eyebrow">Watch</p>
        <h2>Videos</h2>
      </header>
      <div class="videos" data-reveal-group>
        {d.videos.map((v) => (
          <div class="video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${v}`}
              title={`${d.title} — video`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- GALLERY -->
  {d.gallery && d.gallery.length > 0 && (
    <section class="band midnight">
      <header class="band-head" data-reveal>
        <p class="eyebrow">In the mix</p>
        <h2>Gallery</h2>
      </header>
      {d.gallery.length > 4 ? (
        // Más de 4 fotos: carrusel como "On the stage" de los cantantes. Se ven 4 (2 en el celular).
        <div class="g-carousel" data-carousel>
          <button type="button" class="g-arrow g-prev" aria-label="Previous photos" data-prev hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <div class="g-track" data-track data-reveal-group>
            {d.gallery.map((src) => (
              <div class="g-cell"><div class="g-img" style={`background-image:url('${src}')`}></div></div>
            ))}
          </div>
          <button type="button" class="g-arrow g-next" aria-label="More photos" data-next>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      ) : (
        <div class="gallery" data-reveal-group>
          {d.gallery.map((src) => (
            <div class="g-cell"><div class="g-img" style={`background-image:url('${src}')`}></div></div>
          ))}
        </div>
      )}
    </section>
  )}

  <!-- OTHER DJS -->
  <section class="band">
    <header class="band-head" data-reveal>
      <p class="eyebrow">Keep exploring</p>
      <h2>Other DJs</h2>
    </header>
    <div class="rail" data-reveal-group>
      {others.map((o) => (
        <a class="rail-item" href={`/best-djs-in-south-florida/${o.id}/`}>
          <div class="rail-img" style={`background-image:url('${o.data.photo}')`}></div>
          <span class="rail-name">{o.data.title}</span>
        </a>
      ))}
    </div>
  </section>

  <ConnectCTA />

  <style>
    /* HERO */
    .dj-hero { position: relative; height: 68vh; min-height: 460px; display: flex; align-items: flex-end; overflow: hidden; }
    .dj-hero-img { position: absolute; inset: 0; background-size: cover; background-position: center 30%; transform: scale(1.02); }
    .dj-hero-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(17,17,17,0.85) 0%, rgba(17,17,17,0.45) 45%, rgba(17,17,17,0.25) 100%); }
    .dj-hero-content { position: relative; z-index: 2; width: 100%; max-width: var(--maxw); margin: 0 auto; padding: 0 1.5rem 3rem; }
    .dj-hero-content h1 { font-size: clamp(2.8rem, 8vw, 5.5rem); margin-top: 0.6rem; }
    .back-link {
      display: inline-flex; align-items: center; gap: 0.45rem; margin-bottom: 1.2rem;
      color: var(--muted-text); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.18em;
      transition: color 0.25s;
    }
    .back-link::before { content: '←'; }
    .back-link:hover { color: var(--accent-ink); }

    /* SECTION SHELL */
    .band { padding: 5rem 1.5rem; }
    .band > * { max-width: var(--maxw); margin-left: auto; margin-right: auto; }
    .band.midnight { background: var(--midnight); }
    .bio-band { padding-bottom: 1.5rem; }
    .bio-band + .videos-band { padding-top: 1.5rem; }
    .videos-band .band-head { margin-bottom: 2rem; }
    .band-head { text-align: center; margin-bottom: 3rem; }
    .band-head h2 { font-size: clamp(2rem, 4.5vw, 3rem); margin-top: 0.5rem; }

    /* BIO + STATS */
    .bio-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3.5rem; align-items: start; }
    .bio :global(p) { font-size: 1.08rem; line-height: 1.8; color: var(--muted-text); margin: 0 0 1.4rem; }
    .bio :global(em) { color: var(--fg); font-style: italic; }

    .stats { position: sticky; top: 6rem; border: 1px solid var(--line); border-radius: 18px; padding: 2rem; background: var(--card); }
    .stat-block { margin-bottom: 1.8rem; }
    /* Especialidades: lista editorial (Bodoni + rayita dorada), no parecen botones */
    .specs { list-style: none; margin: 1rem 0 0; padding: 0; }
    .specs li { display: flex; align-items: center; gap: 0.9rem; padding: 0.75rem 0; border-top: 1px solid var(--line); font-family: var(--font-display); font-size: 1.32rem; line-height: 1.2; color: var(--fg); }
    .specs li:first-child { border-top: 0; padding-top: 0.2rem; }
    .specs li::before { content: ""; flex: none; width: 18px; height: 1px; background: var(--accent); }
    .chips { list-style: none; margin: 0.9rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .chips li {
      padding: 0.45rem 0.95rem; border-radius: 999px; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase;
      border: 1px solid var(--line); color: var(--fg);
    }
    .chips.chips-soft li { color: var(--muted-text); }
    .stat-cta { display: block; text-align: center; margin-top: 0.5rem; }

    /* IN DISTINGUISHED COMPANY */
    .company-band { padding-top: 3.5rem; padding-bottom: 1.5rem; }
    .company-band + .videos-band { padding-top: 3rem; }
    .company-head { margin-bottom: 2.75rem; }
    .company-rule { display: block; width: 44px; height: 1px; margin: 1.4rem auto 0; background: var(--accent); }
    .company-sub { max-width: 34rem; margin: 1.2rem auto 0; font-size: 1.08rem; line-height: 1.7; color: var(--muted-text); }
    .company-draft-note {
      display: inline-block; margin: 1.2rem auto 0; padding: 0.5rem 0.9rem; border: 1px dashed var(--line-gold);
      border-radius: 8px; font-size: 0.8rem; color: var(--accent-ink);
    }
    .company-band .company { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    .company figure { margin: 0; }
    .company-photo { aspect-ratio: 3 / 4; border-radius: 10px; overflow: hidden; background: var(--champagne); border: 1px solid var(--line); }
    .company-photo img {
      width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block;
      transition: transform 0.9s cubic-bezier(0.16,1,0.3,1);
    }
    .company-item:hover .company-photo img { transform: scale(1.025); }
    .company-placeholder {
      height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.9rem;
      border: 1px dashed var(--line-gold); border-radius: 10px;
      background: linear-gradient(160deg, var(--champagne), var(--ivory));
    }
    .ph-mono { font-family: var(--font-display); font-size: 2.6rem; letter-spacing: 0.04em; color: var(--accent-ink); }
    .ph-label { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted-text); }
    .company figcaption { display: flex; flex-direction: column; gap: 0.35rem; padding-top: 1rem; text-align: center; }
    .company-name { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.2; color: var(--fg); }
    .company-note { font-size: 0.95rem; line-height: 1.55; color: var(--muted-text); }
    .company-pending { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-ink); }

    /* Tablet: two columns */
    @media (max-width: 1024px) {
      .company-band .company { grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; max-width: 640px; }
    }
    /* Mobile: swipeable carousel with scroll-snap */
    @media (max-width: 640px) {
      .company-band .company {
        display: flex; gap: 1rem; max-width: none; overflow-x: auto; overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
        margin: 0 -1.5rem; padding: 0 1.5rem 1rem; scroll-padding-inline: 1.5rem; scrollbar-width: none;
      }
      .company::-webkit-scrollbar { display: none; }
      .company-item { flex: 0 0 72%; scroll-snap-align: start; }
    }

    /* GALLERY */
    .gallery { display: flex; gap: 1rem; }
    .g-cell { border-radius: 14px; overflow: hidden; flex: 1; min-width: 0; }
    .g-img { aspect-ratio: 3 / 4; background-size: cover; background-position: center; transition: transform 0.6s cubic-bezier(0.16,1,0.3,1); }
    .g-cell:hover .g-img { transform: scale(1.06); }
    /* Carrusel (más de 4 fotos): 4 por vista, 2 en el celular; con el dedo o con las flechas */
    .g-carousel { position: relative; }
    .g-track { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
    .g-track::-webkit-scrollbar { display: none; }
    .g-track .g-cell { flex: 0 0 calc((100% - 3rem) / 4); scroll-snap-align: start; }
    .g-arrow { position: absolute; top: 50%; z-index: 2; transform: translateY(-50%); display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.28); background: rgba(10, 10, 10, 0.6); color: #fff; cursor: pointer; backdrop-filter: blur(6px); transition: background 0.2s ease, border-color 0.2s ease; }
    .g-arrow:hover { background: rgba(10, 10, 10, 0.85); border-color: rgba(255, 255, 255, 0.6); }
    .g-arrow:focus-visible { outline: 2px solid #d9b866; outline-offset: 2px; }
    .g-arrow[hidden] { display: none; }
    .g-arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .g-prev { left: -23px; }
    .g-next { right: -23px; }

    /* VIDEOS */
    .videos { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 1.5rem; max-width: 920px; margin: 0 auto; }
    .video { aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: #000; }
    .video iframe { width: 100%; height: 100%; border: 0; display: block; }
    @media (max-width: 520px) { .videos { grid-template-columns: 1fr; } }

    /* OTHER DJS RAIL */
    .rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(190px, 1fr); gap: 1.25rem; overflow-x: auto; padding-bottom: 1rem; scroll-snap-type: x mandatory; }
    .rail-item { position: relative; display: block; border-radius: 14px; overflow: hidden; scroll-snap-align: start; }
    .rail-img { aspect-ratio: 3 / 4; background-size: cover; background-position: center top; transition: transform 0.6s cubic-bezier(0.16,1,0.3,1); }
    .rail-item:hover .rail-img { transform: scale(1.06); }
    .rail-item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.78), transparent 55%); }
    .rail-name { position: absolute; left: 1rem; bottom: 0.9rem; z-index: 2; font-family: var(--font-display); font-size: 1.1rem; }
    .rail::-webkit-scrollbar { height: 6px; }
    .rail::-webkit-scrollbar-thumb { background: var(--line-gold); border-radius: 999px; }

    /* CLOSING CTA */
    .cta-band { text-align: center; }
    .cta-inner h2 { font-size: clamp(2rem, 4.5vw, 3rem); margin: 0.6rem 0 0.8rem; }
    .cta-sub { color: var(--muted-text); margin: 0 auto 2rem; max-width: 36rem; }

    @media (max-width: 860px) {
      .bio-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .stats { position: static; }
      .gallery { flex-wrap: wrap; }
      .gallery .g-cell { flex: 0 0 calc((100% - 1rem) / 2); }
      .g-track .g-cell { flex-basis: calc((100% - 1rem) / 2); }
      .g-prev { left: 6px; }
      .g-next { right: 6px; }
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(html.js) [data-reveal],
      :global(html.js) [data-reveal-group] > * { opacity: 0; }
    }
  </style>

  <script>
    import { animate, inView, stagger } from 'motion';

    // Carrusel de la galería (igual que en los cantantes): las flechas pasan una página y se ocultan en los extremos.
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
      const track = c.querySelector<HTMLElement>('[data-track]');
      const prev = c.querySelector<HTMLButtonElement>('[data-prev]');
      const next = c.querySelector<HTMLButtonElement>('[data-next]');
      if (!track || !prev || !next) return;
      const step = () => track.clientWidth + 16;
      const update = () => {
        prev.hidden = track.scrollLeft < 4;
        next.hidden = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
      next.addEventListener('click', () => track.scrollBy({ left: step() }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });

    inView('[data-reveal]', (el) => {
      animate(el, { opacity: [0, 1], y: [30, 0] }, { duration: 0.8, ease: [0.16, 1, 0.3, 1] });
    }, { margin: '0px 0px -10% 0px' });

    document.querySelectorAll('[data-reveal-group]').forEach((group) => {
      inView(group, () => {
        animate(Array.from(group.children), { opacity: [0, 1], y: [30, 0] },
          { delay: stagger(0.08), duration: 0.7, ease: [0.16, 1, 0.3, 1] });
      }, { margin: '0px 0px -10% 0px' });
    });
  </script>
</Noir>
